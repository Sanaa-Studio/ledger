{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "validate": "pnpm lint && pnpm typecheck",
    "dev": "APP_ENV=development NODE_ENV=development tsx watch src/index.ts",
    "beta": "APP_ENV=beta NODE_ENV=production pnpm build && node dist/index.js",
    "build": "rm -rf dist && tsc",
    "start": "node dist/index.js",
    "test": "APP_ENV=test NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest src/tests --runInBand",
    "test:service": "APP_ENV=test NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest src/tests/service",
    "test:watch": "APP_ENV=test NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest src/tests/service --watch",
    "db:test-connection": "APP_ENV=development tsx src/utils/testingDbConnection.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@ledger/contracts": "workspace:*",
    "@ledger/database": "workspace:*",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^1.0.0-rc.4",
    "express": "^5.2.1",
    "pg": "^8.23.0",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.4.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^10.0.0",
    "drizzle-kit": "^1.0.0-rc.4",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.9.0",
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  }
}
