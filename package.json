{
  "name": "ledger",
  "private": true,
  "workspaces": [
    "backend",
    "database",
    "frontend"
  ],
  "version": "1.0.0",
  "description": "Personal budgeting application",
  "homepage": "https://github.com/Sanaa-Studio/ledger#readme",
  "bugs": {
    "url": "https://github.com/Sanaa-Studio/ledger/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sanaa-Studio/ledger.git"
  },
  "license": "ISC",
  "author": "Daniel Ngira",
  "type": "module",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "db": "docker compose --env-file .env.compose exec postgres psql -U sanaastudio -d postgres",
    "db:test": "docker compose --env-file .env.compose exec postgres-test sh -c 'psql -U \"$POSTGRES_USER\" -d \"$POSTGRES_DB\"'",

    "docker:ps": "docker compose --env-file .env.compose ps",
    "docker:db": "docker compose --env-file .env.compose up -d postgres",
    "docker:test-db": "docker compose --env-file .env.compose up -d postgres-test",

    "docker:up": "docker compose --env-file .env.compose up",
    "docker:down": "docker compose --env-file .env.compose down",
    "docker:build": "docker compose --env-file .env.compose up --build",
    
    "build": "rm -rf dist && tsc",
    "build:db": "npm run build -w @ledger/database",
    "build:backend": "npm run build -w backend"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "drizzle-orm": "^1.0.0-rc.4",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^1.0.0-rc.4",
    "tsx": "^4.23.12"
  }
}
