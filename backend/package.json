{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "prepare": "husky",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "validate": "npm run lint && npm run format:check && npm run typecheck",
    "dev": "APP_ENV=development NODE_ENV=development tsx watch src/index.ts",
    "beta": "APP_ENV=beta NODE_ENV=production npm run build && node dist/index.js",
    "build": "rm -rf dist && tsc",
    "start": "node dist/index.js",
    "test": "tsx --test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@ledger/database": "1.0.0",
